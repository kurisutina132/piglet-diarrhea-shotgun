/*
 * piglet-diarrhea-shotgun - base configuration.
 *
 * House rule: parameters that gate behaviour have no permissive default. They
 * are null on purpose and main.nf stops with a clear message when they are
 * missing. Tool versions are always pinned (conda: envs/*.yml, docker: tags
 * below); there is no `latest` tag anywhere.
 */

manifest {
    name            = 'piglet-diarrhea-shotgun'
    author          = 'Cristy Medina Armijo'
    description     = 'Shotgun metagenomic reanalysis of PRJNA979345 (piglet diarrhoea): host depletion and MetaPhlAn 4 profiling'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    license         = 'MIT'
    nextflowVersion = '>=24.04.0'
}

params {
    // --- guards: no default, on purpose -------------------------------------
    outdir           = null   // output directory
    sscrofa_index    = null   // bowtie2 index PREFIX for Sscrofa11.1 (scripts/build_sscrofa_index.sh)
    human_index      = null   // bowtie2 index PREFIX for GRCh38 no-alt (scripts/build_grch38_index.sh)
    metaphlan_index  = null   // e.g. mpa_vJan25_CHOCOPhlAnSGB_202503
    metaphlan_db     = null   // directory holding the MetaPhlAn database

    // --- sealed references ---------------------------------------------------
    verify_references     = true   // md5-check the host indices before host removal
    references_checksums  = "${projectDir}/../references/checksums.tsv"

    // --- input ---------------------------------------------------------------
    samplesheet      = "${projectDir}/../data/metadata.tsv"
    runs             = null   // optional comma-separated run accessions to keep (testing)

    // --- demo / CI only: NOT used for the main results ------------------------
    subsample        = null   // read pairs to keep per sample (seqtk); null = use all reads
    seed             = 42

    // --- fastp ---------------------------------------------------------------
    // The paper trims low-quality bases (Q < 30): sliding-window trimming from both ends.
    fastp_cut_quality        = 30   // --cut_mean_quality, Q30 as in the source paper
    fastp_cut_window         = 4    // --cut_window_size (fastp default)
    // Read-level filter left at fastp defaults (the paper does not specify one).
    fastp_qualified_quality  = 15   // --qualified_quality_phred (fastp default)
    fastp_unqualified_percent = 40  // --unqualified_percent_limit (fastp default)
    fastp_min_length         = 50   // minimum read length kept after trimming

    // --- host removal --------------------------------------------------------
    bowtie2_preset   = '--very-sensitive'

    // --- MetaPhlAn -----------------------------------------------------------
    metaphlan_analysis_type = 'rel_ab_w_read_stats'
    metaphlan_unclassified_estimation = true   // false adds --skip_unclassified_estimation

    // --- operational ---------------------------------------------------------
    fetch_retries    = 3
    envs_dir         = "${projectDir}/../envs"

    // --- pinned docker images (verified on quay.io) --------------------------
    container_sra        = 'quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
    container_seqtk      = 'quay.io/biocontainers/seqtk:1.4--he4a0461_2'
    container_fastp      = 'quay.io/biocontainers/fastp:0.24.0--heae3180_1'
    container_host       = 'quay.io/biocontainers/mulled-v2-c742dccc9d8fabfcff2af0d8d6799dbc711366cf:7d8874158a9103084ff44dcf024a118242d67478-0'  // bowtie2 2.5.4 + samtools 1.21
    container_metaphlan  = 'quay.io/biocontainers/metaphlan:4.2.4--pyhdfd78af_0'
}

// Fail fast on any command in a pipe.
process.shell = ['/bin/bash', '-euo', 'pipefail']

process {
    cpus   = 1
    memory = 2.GB
    time   = 12.h

    // Anything that is not a download is deterministic: a failure is not retried.
    errorStrategy = 'terminate'

    // Resource labels, sized for a 20-core / 39 GB host.
    withLabel: process_low    { cpus = 2;  memory = 4.GB }
    withLabel: process_medium { cpus = 8;  memory = 8.GB }
    // Aligners: one at a time so that RAM (indices) and cores are not oversubscribed.
    withLabel: process_host   { cpus = 16; memory = 12.GB; maxForks = 1 }
    // MetaPhlAn loads the whole marker database: ~20+ GB RAM.
    withLabel: process_metaphlan { cpus = 16; memory = 26.GB; maxForks = 1 }
}

profiles {
    conda {
        conda.enabled      = true
        conda.useMicromamba = true
        conda.channels     = ['conda-forge', 'bioconda']
        docker.enabled     = false
    }
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        conda.enabled      = false
    }
    test {
        // Two samples, one per group, for the CP2 check.
        params.runs = 'SRR34060196,SRR34060199'
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir ?: 'results'}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir ?: 'results'}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir ?: 'results'}/pipeline_info/trace.tsv" }
